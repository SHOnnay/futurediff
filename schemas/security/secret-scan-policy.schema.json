{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futurediff.dev/schemas/secret-scan-policy-0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enabled", "block_severities"],
  "properties": {
    "version": {"const": "0.1"},
    "enabled": {"type": "boolean"},
    "block_severities": {"type": "array", "uniqueItems": true, "items": {"enum": ["high", "medium"]}},
    "allowed_fingerprints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
