{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futurediff.dev/schemas/approval/quorum-bundle.schema.json",
  "title": "FutureDiff approval quorum bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "envelopes", "digest"],
  "properties": {
    "version": {"const": "0.1"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "envelopes": {"type": "array", "minItems": 1, "items": {"$ref": "envelope.schema.json"}}
  }
}
