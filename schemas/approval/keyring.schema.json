{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futurediff.dev/schemas/approval/keyring-0.1.json",
  "title": "FutureDiff approval keyring",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "keys"],
  "properties": {
    "version": {"const": "0.1"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "approver", "public_key", "enabled"],
        "properties": {
          "key_id": {"type": "string"},
          "approver": {"type": "string"},
          "public_key": {"type": "string"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
