{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "environment": {"minLength": 1, "type": "string"},
          "expires_at": {"format": "date-time", "type": ["string", "null"]},
          "id": {"minLength": 1, "type": "string"},
          "issued_at": {"format": "date-time", "type": "string"},
          "path": {"minLength": 1, "type": "string"},
          "producer": {"minLength": 1, "type": "string"},
          "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "source": {"minLength": 1, "type": "string"},
          "synthetic": {"type": "boolean"},
          "type": {"minLength": 1, "type": "string"}
        },
        "required": ["id", "type", "path", "sha256", "producer", "source", "environment", "issued_at", "synthetic"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": ["evidence"],
  "title": "FutureDiff external evidence specification",
  "type": "object"
}
