{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "approved": {"type": "boolean"},
    "archive_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "kind": {"const": "production_promotion_decision"},
    "passed": {"type": "boolean"},
    "promotion_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "scope": {"const": "external-production-promotion"},
    "version": {"minLength": 1, "type": "string"}
  },
  "required": ["kind", "passed", "approved", "scope", "version", "archive_sha256", "promotion_digest"],
  "title": "FutureDiff production promotion decision",
  "type": "object"
}
