    "started_at":{"type":"string","format":"date-time"}, "finished_at":{"type":"string","format":"date-time"},
    "input_tokens":{"type":"integer","minimum":0}, "output_tokens":{"type":"integer","minimum":0}, "cached_input_tokens":{"type":"integer","minimum":0}, "model_calls":{"type":"integer","minimum":0}, "tool_calls":{"type":"integer","minimum":0}, "repair_turns":{"type":"integer","minimum":0}, "verification_ms":{"type":"integer","minimum":0}, "compute_ms":{"type":"integer","minimum":0}, "released_effects":{"type":"integer","minimum":0}, "unsafe_effects":{"type":"integer","minimum":0}, "duplicate_effects":{"type":"integer","minimum":0}, "success":{"type":"boolean"}
  }
