{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futurediff.dev/schemas/evidence/keyring.schema.json",
  "title": "FutureDiff evidence encryption keyring",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "active_key_id", "keys"],
  "properties": {
    "version": {"const": "0.1"},
    "active_key_id": {"type": "string", "minLength": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "path", "enabled"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
