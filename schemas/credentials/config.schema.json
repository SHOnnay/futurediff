{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futurediff.dev/schemas/credentials/config-0.1.json",
  "title": "FutureDiff credential broker configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "adapters", "credentials"],
  "properties": {
    "version": {"const": "0.1"},
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_id", "version", "trust_level", "enabled"],
        "properties": {
          "adapter_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "trust_level": {"enum": ["built_in", "verified", "untrusted"]},
          "executable_digest": {"type": "string"},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential_id", "provider", "source", "allowed_adapters", "allowed_operations", "allowed_destinations", "enabled"],
        "properties": {
          "credential_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "account": {"type": "string"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference"],
            "properties": {
              "kind": {"const": "environment"},
              "reference": {"type": "string", "minLength": 1}
            }
          },
          "allowed_adapters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_destinations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scheme", "host"],
              "properties": {
                "scheme": {"const": "https"},
                "host": {"type": "string", "minLength": 1},
                "port": {"enum": ["", "443"]},
                "path_prefix": {"type": "string", "pattern": "^/"}
              }
            }
          },
          "expires_at": {"type": "string", "format": "date-time"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
