{
  "format_version": "1.0",
  "service": {
    "name": "FutureDiff",
    "version": "1.40.0",
    "owner": "platform@example.invalid"
  },
  "environments": {
    "staging": {
      "region": "region-primary",
      "replicas": 2,
      "runtime": "rootless-oci",
      "database": {"engine": "sqlite", "durability": "wal"},
      "queue": {"engine": "durable-ledger", "delivery": "at-least-once"},
      "secret_provider": "environment",
      "observability": {"metrics": "otel", "logs": "structured-json", "traces": "otel"},
      "backup": {"rpo_seconds": 300, "rto_seconds": 900}
    },
    "production": {
      "region": "region-primary",
      "replicas": 3,
      "runtime": "rootless-oci",
      "database": {"engine": "sqlite", "durability": "wal"},
      "queue": {"engine": "durable-ledger", "delivery": "at-least-once"},
      "secret_provider": "environment",
      "observability": {"metrics": "otel", "logs": "structured-json", "traces": "otel"},
      "backup": {"rpo_seconds": 300, "rto_seconds": 900}
    }
  }
}
