    { "from": "PREVIEWED", "to": "UNKNOWN" },
    { "from": "VERIFIED", "to": "PREPARED" },
    { "from": "VERIFIED", "to": "APPROVED" },
    { "from": "VERIFIED", "to": "ABORTED" },
    { "from": "VERIFIED", "to": "UNKNOWN" },
    { "from": "APPROVED", "to": "PREPARED" },
    { "from": "APPROVED", "to": "COMMITTING" },
    { "from": "APPROVED", "to": "ABORTED" },
    { "from": "APPROVED", "to": "UNKNOWN" },
    { "from": "COMMITTING", "to": "COMMITTED" },
    { "from": "COMMITTING", "to": "UNKNOWN" },
    { "from": "UNKNOWN", "to": "COMMITTED" },
    { "from": "UNKNOWN", "to": "ABORTED" },
    { "from": "UNKNOWN", "to": "COMPENSATING" },
    { "from": "COMMITTED", "to": "COMPENSATING" },
    { "from": "COMPENSATING", "to": "COMPENSATED" }
  ]
