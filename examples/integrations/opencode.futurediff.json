{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "futurediff": {
      "command": [
        "/opt/futurediff/bin/futurediff-mcp",
        "--socket",
        "/home/USER/.futurediff/futurediff.sock"
      ],
      "enabled": true,
      "timeout": 10000,
      "type": "local"
    }
  },
  "permission": {
    "*": "ask",
    "bash": "deny",
    "edit": "deny",
    "futurediff_*": "allow"
  }
}
