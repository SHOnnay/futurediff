{
  "version": "0.1",
  "adapters": [
    {
      "adapter_id": "builtin.github.branch-publish",
      "version": "0.1.0",
      "trust_level": "built_in",
      "executable_digest": "builtin:builtin.github.branch-publish@0.1.0",
      "enabled": true
    },
    {
      "adapter_id": "builtin.github.draft-pull-request",
      "version": "0.1.0",
      "trust_level": "built_in",
      "executable_digest": "builtin:builtin.github.draft-pull-request@0.1.0",
      "enabled": true
    },
    {
      "adapter_id": "builtin.slack.message-outbox",
      "version": "0.1.0",
      "trust_level": "built_in",
      "executable_digest": "builtin:builtin.slack.message-outbox@0.1.0",
      "enabled": true
    }
  ],
  "credentials": [
    {
      "credential_id": "github-main",
      "provider": "github",
      "account": "example-organization",
      "source": {
        "kind": "environment",
        "reference": "FUTUREDIFF_GITHUB_TOKEN"
      },
      "allowed_adapters": [
        "builtin.github.branch-publish",
        "builtin.github.draft-pull-request"
      ],
      "allowed_operations": [
        "github.query_git_ref",
        "github.publish_branch",
        "github.read_refs",
        "github.query_pull_requests",
        "github.create_draft_pull_request"
      ],
      "allowed_destinations": [
        {
          "scheme": "https",
          "host": "github.com",
          "path_prefix": "/example-organization/example-repository.git"
        },
        {
          "scheme": "https",
          "host": "api.github.com",
          "path_prefix": "/repos/example-organization/example-repository"
        }
      ],
      "enabled": true
    },
    {
      "credential_id": "slack-main",
      "provider": "slack",
      "account": "example-workspace",
      "source": {
        "kind": "environment",
        "reference": "FUTUREDIFF_SLACK_TOKEN"
      },
      "allowed_adapters": [
        "builtin.slack.message-outbox"
      ],
      "allowed_operations": [
        "slack.query_channel_history",
        "slack.post_message"
      ],
      "allowed_destinations": [
        {
          "scheme": "https",
          "host": "slack.com",
          "path_prefix": "/api"
        }
      ],
      "enabled": true
    }
  ]
}
