{
  "version": "1",
  "default": "deny",
  "agent_roles": [
    "agent"
  ],
  "roles": [
    {
      "name": "agent",
      "operations": [
        "health",
        "contract",
        "openapi",
        "transaction_create",
        "transaction_list",
        "transaction_get",
        "transaction_execute",
        "github_branch_prepare",
        "github_pr_prepare",
